#!/usr/bin/env python3
"""Render the Puck Kiosk Windows icon from the fetched 2D Puck sprite.

The icon is a rounded square filled with the app's secondary colour gradient
(#2f372f to #1a231c, from car_ui.cpp) with the Puck sprite drawn large inside
it, his body filling the tile edge to edge.

The sprite and the rendered icon are Amp art, so neither is committed: the
sprite lives in the gitignored assets/cache and the icon in the gitignored
.cache directory. Only this script is tracked.

Requires ImageMagick (magick or convert) and the sprite from
`tools/fetch-assets`.
"""

from __future__ import annotations

import argparse
import shutil
import subprocess
import sys
from pathlib import Path

TILE = 1024
CORNER_RADIUS = round(TILE * 0.22)  # conventional app-icon corner radius
BACKGROUND_TOP = "#2f372f"  # app secondary colour (car_ui.cpp kSecondary)
BACKGROUND_BOTTOM = "#1a231c"
SPRITE_CROP = "440x520+30+10"  # Puck's body; the legs are cropped by the tile
SPRITE_SCALE = 1.12  # relative to the sprite filling the tile
SPRITE_CENTER = (0.58, 0.61)  # sprite centre, as a fraction of the tile side
ICON_SIZES = "256,128,64,48,32,16"


def find_magick() -> str:
    for name in ("magick", "convert"):
        program = shutil.which(name)
        if program:
            return program
    raise SystemExit("ImageMagick is required (magick or convert)")


def find_sprite(root: Path, explicit: Path | None) -> Path:
    if explicit is not None:
        if not explicit.is_file():
            raise SystemExit(f"sprite not found: {explicit}")
        return explicit
    sprites = sorted((root / "assets" / "cache" / "avatars").glob("classic-*.png"))
    if not sprites:
        raise SystemExit("no fetched sprite: run tools/fetch-assets first")
    return sprites[0]


def main() -> int:
    root = Path(__file__).resolve().parent.parent
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--sprite",
        type=Path,
        help="2D sprite PNG (default: assets/cache/avatars/classic-*.png)",
    )
    parser.add_argument(
        "--output",
        type=Path,
        default=root / ".cache" / "win32" / "puck-kiosk.ico",
        help="output .ico (default: .cache/win32/puck-kiosk.ico)",
    )
    parser.add_argument("--preview", type=Path, help="also write a 256x256 PNG preview")
    args = parser.parse_args()

    sprite = find_sprite(root, args.sprite)
    magick = find_magick()
    args.output.parent.mkdir(parents=True, exist_ok=True)

    subprocess.run(
        [
            magick,
            "-size",
            f"{TILE}x{TILE}",
            f"gradient:{BACKGROUND_TOP}-{BACKGROUND_BOTTOM}",
            "(",
            str(sprite),
            "-crop",
            SPRITE_CROP,
            "+repage",
            # Mirror the sprite so Puck faces left.
            "-flop",
            "-resize",
            f"{TILE}x{TILE}^",
            "-resize",
            f"{round(SPRITE_SCALE * 100)}%",
            ")",
            "-gravity",
            "center",
            "-geometry",
            "%+d%+d"
            % (
                round((SPRITE_CENTER[0] - 0.5) * TILE),
                round((SPRITE_CENTER[1] - 0.5) * TILE),
            ),
            "-composite",
            # Clip the sprite to the rounded tile: without this the arms and
            # body escape the background at the edges and corners.
            "(",
            "-size",
            f"{TILE}x{TILE}",
            "xc:black",
            "-fill",
            "white",
            "-draw",
            f"roundrectangle 0,0 {TILE - 1},{TILE - 1} {CORNER_RADIUS},{CORNER_RADIUS}",
            ")",
            "-alpha",
            "off",
            "-compose",
            "CopyOpacity",
            "-composite",
            "-define",
            f"icon:auto-resize={ICON_SIZES}",
            str(args.output),
        ],
        check=True,
    )

    if args.preview is not None:
        args.preview.parent.mkdir(parents=True, exist_ok=True)
        subprocess.run(
            [magick, f"{args.output}[0]", "-resize", "256x256", str(args.preview)],
            check=True,
        )

    print(args.output)
    return 0


if __name__ == "__main__":
    sys.exit(main())
