#!/usr/bin/env python3
"""Fetch the development Puck assets into a gitignored cache.

The repository stores only the manifest (URL, size, SHA-256). The binaries are
Amp's copyrighted art, so they are downloaded on demand and never committed.
"""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def download(url: str, destination: Path) -> None:
    destination.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile(prefix=".fetch-", dir=destination.parent, delete=False) as handle:
        temporary = Path(handle.name)
    try:
        subprocess.run(
            ["curl", "--compressed", "-fsSL", "--retry", "3", "-o", str(temporary), url],
            check=True,
        )
        os.replace(temporary, destination)
    finally:
        temporary.unlink(missing_ok=True)


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--dest",
        type=Path,
        default=Path("assets/cache"),
        help="cache directory (default: assets/cache)",
    )
    parser.add_argument("--force", action="store_true", help="re-download files that already match")
    args = parser.parse_args()

    if shutil.which("curl") is None:
        print("curl is required", file=sys.stderr)
        return 2

    manifest_path = Path(__file__).resolve().parent.parent / "assets" / "manifest.json"
    manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
    destination_root = args.dest if args.dest.is_absolute() else Path.cwd() / args.dest

    fetched = 0
    skipped = 0
    for asset in manifest["assets"]:
        relative = Path(asset["path"])
        destination = destination_root / relative
        expected = asset["sha256"]
        expected_bytes = int(asset["bytes"])

        if destination.exists() and not args.force:
            if destination.stat().st_size == expected_bytes and sha256(destination) == expected:
                print(f"ok      {relative}")
                skipped += 1
                continue
            print(f"replace {relative} (hash mismatch)")

        print(f"fetch   {relative}")
        download(asset["url"], destination)
        actual_bytes = destination.stat().st_size
        actual_hash = sha256(destination)
        if actual_bytes != expected_bytes or actual_hash != expected:
            destination.unlink(missing_ok=True)
            print(
                f"error: {relative} failed verification "
                f"(size {actual_bytes}/{expected_bytes}, sha256 {actual_hash})",
                file=sys.stderr,
            )
            return 1
        fetched += 1

    print(f"done: {fetched} fetched, {skipped} already cached in {destination_root}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
